<Window x:Class="ZCompression.App.ArchivePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZCompression.App"
        Title="{local:Loc ArchivePassword}" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <StackPanel Margin="24">
        <TextBlock Text="{local:Loc PasswordPrompt}" TextWrapping="Wrap"/>
        <TextBlock x:Name="ArchiveNameText" Margin="0,8,0,12" TextTrimming="CharacterEllipsis"/>
        <PasswordBox x:Name="PasswordInput" Padding="8"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="{local:Loc Cancel}" IsCancel="True" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
            <Button Content="{local:Loc Open}" IsDefault="True" Click="OnAccept" Style="{StaticResource AccentButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
