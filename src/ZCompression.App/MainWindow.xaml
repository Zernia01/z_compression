<Window x:Class="ZCompression.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="z_compression" Height="800" Width="1280" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B87FF" Offset="0" /><GradientStop Color="#6552DF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ToolbarTextButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="11,9" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="11,10" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="218" /><ColumnDefinition Width="*" /><ColumnDefinition Width="294" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="29" /></Grid.RowDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
            <Grid x:Name="ExpandedSidebar">
                <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,20,12,18" VerticalAlignment="Top">
                    <Image Source="/Assets/icon.png" Width="34" Height="34" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="z_compression" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="ARCHIVE STUDIO" FontSize="8" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Tag="Selected" Click="OnHome">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" FontFamily="Segoe UI Emoji" FontSize="16" Width="28" /><TextBlock Text="홈" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnNewArchive">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="새 압축" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnExtract">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🗜️" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="압축 풀기" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnOpen">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📂" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="압축 파일 열기" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Separator Margin="20,14" Background="{DynamicResource BorderBrush}" />
                    <Button Style="{StaticResource NavButton}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🕘" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="최근 작업" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button Style="{StaticResource NavButton}" Click="OnSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="설정" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnSidebarToggle">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◀" FontSize="15" Width="28" /><TextBlock Text="사이드바 접기" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="CollapsedSidebar" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Image Source="/Assets/icon.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Tag="Selected" Margin="8,2" Padding="10" Click="OnHome" ToolTip="홈"><TextBlock Text="🏠" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnNewArchive" ToolTip="새 압축"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnExtract" ToolTip="압축 풀기"><TextBlock Text="🗜️" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnOpen" ToolTip="압축 파일 열기"><TextBlock Text="📂" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" IsEnabled="False" ToolTip="최근 작업"><TextBlock Text="🕘" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnSettings" ToolTip="설정"><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnSidebarToggle" ToolTip="사이드바 펼치기"><TextBlock Text="▶" FontSize="14" /></Button>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>

        <!-- Top command bar -->
        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="⬅️" ToolTip="상위 폴더" IsEnabled="{Binding CanNavigateUp}" Click="OnNavigateUp" />
                    <Button Style="{StaticResource IconButton}" Content="⬆️" ToolTip="상위 폴더" IsEnabled="{Binding CanNavigateUp}" Click="OnNavigateUp" />
                    <Border Margin="8,0" Width="1" Height="24" Background="{DynamicResource BorderBrush}" />
                    <Button Style="{StaticResource ToolbarTextButton}" Click="OnOpen">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📂" FontFamily="Segoe UI Emoji" Margin="0,0,7,0" /><TextBlock Text="{Binding BreadcrumbText}" /></StackPanel>
                    </Button>
                </StackPanel>
                <TextBox Grid.Column="1" Width="250" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="압축 파일 안에서 검색" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarTextButton}" Content="새 압축" Click="OnNewArchive" />
                    <Button Style="{StaticResource ToolbarTextButton}" Content="압축 풀기" Click="OnExtract" />
                    <Button Style="{StaticResource ToolbarTextButton}" Content="검사" Click="OnTest" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Home workspace -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource WorkspaceBackgroundBrush}" Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0">
                <Image Source="/Assets/icon.png" Width="68" Height="68" HorizontalAlignment="Center" />
                <TextBlock Text="파일은 더 작게, 작업은 더 빠르게." FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,24,0,0" />
                <TextBlock Text="ZIP과 7Z를 빠르게 만들고, 다양한 압축 파일을 안전하게 풀어보세요." FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <Button Style="{StaticResource AccentButton}" Click="OnNewArchive" Margin="4"><StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,7,0"/><TextBlock Text="새 압축 만들기"/></StackPanel></Button>
                    <Button Style="{StaticResource OutlineButton}" Click="OnOpen" Margin="4"><StackPanel Orientation="Horizontal"><TextBlock Text="📂" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,7,0"/><TextBlock Text="압축 파일 열기"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,15">
                    <TextBlock Text="⚡ 스트리밍 처리" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" />
                    <TextBlock Text="🛡️ 안전한 경로 검사" FontFamily="Segoe UI Emoji, Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" />
                    <TextBlock Text="🌏 Unicode 파일명" FontFamily="Segoe UI Emoji, Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" />
                </StackPanel>
                <Grid Height="64" Margin="18,0">
                    <Rectangle RadiusX="9" RadiusY="9" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="4 4" />
                    <TextBlock Text="파일 또는 폴더를 여기에 놓으세요" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Archive explorer workspace -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource WorkspaceBackgroundBrush}" Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="27" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" Click="OnExtract"><StackPanel Orientation="Horizontal"><TextBlock Text="🗜️" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="압축 풀기"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="➕" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="파일 추가"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="🗑️" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="파일 삭제"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" Click="OnTest"><StackPanel Orientation="Horizontal"><TextBlock Text="🧪" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="테스트"/></StackPanel></Button>
                    <Separator Width="1" Margin="8,8" Background="{DynamicResource BorderBrush}" />
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" Click="OnSettings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="설정"/></StackPanel></Button>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BreadcrumbText}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="폴더를 두 번 클릭하면 안으로 이동합니다." FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BrowserItems.Count, StringFormat={}{0:N0}개 항목}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </Grid>
            <DataGrid Grid.Row="2" Margin="0" ItemsSource="{Binding BrowserItems}" SelectedItem="{Binding SelectedBrowserItem, Mode=TwoWay}" MouseDoubleClick="OnArchiveItemDoubleClick"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" HeadersVisibility="Column"
                      Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource ControlBackgroundBrush}"
                      CellStyle="{StaticResource GridCell}" ColumnHeaderStyle="{StaticResource GridHeader}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="이름" Width="2.6*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="압축 크기" Binding="{Binding CompressedSize, StringFormat={}{0:N0} B}" Width="1.1*" />
                    <DataGridTextColumn Header="원본 크기" Binding="{Binding OriginalSize, StringFormat={}{0:N0} B}" Width="1.1*" />
                    <DataGridTextColumn Header="파일 종류" Binding="{Binding TypeText}" Width="1.3*" />
                    <DataGridTextColumn Header="수정 날짜" Binding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}">
                <TextBlock Text="{Binding BrowserStatus}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Details pane -->
        <Border Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" FontSize="15" Margin="0,0,9,0" /><TextBlock Text="상세 정보" FontWeight="SemiBold" /></StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="×" Click="OnCloseDetails" BorderThickness="0" Background="Transparent" />
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />

                <StackPanel Grid.Row="1" Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                    <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="36" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="항목을 선택하세요" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0" />
                    <TextBlock Text="파일 크기와 경로, 체크섬 정보를 확인할 수 있습니다." TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibility}}" Margin="22,28">
                    <Border Width="54" Height="54" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,2" />
                    <TextBlock Text="{Binding SelectedEntry.Path}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" />
                    <Separator Margin="0,22" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="원본 크기" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.OriginalSize, StringFormat={}{0:N0} bytes}" Margin="0,4,0,15" />
                    <TextBlock Text="압축 크기" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.CompressedSize, StringFormat={}{0:N0} bytes}" Margin="0,4,0,15" />
                    <TextBlock Text="수정 날짜" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.Modified, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Margin="0,4,0,15" />
                    <TextBlock Text="CRC / Checksum" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.Checksum}" FontFamily="Consolas" Margin="0,4,0,15" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="13,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                <ProgressBar Grid.Column="1" Height="3" Margin="18,0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressDetails}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource NavButton}" Padding="5,1" Margin="0" Content="취소" Click="OnCancel" IsEnabled="{Binding IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
