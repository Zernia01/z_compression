<Window x:Class="ZCompression.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZCompression.App"
        Title="z_compression" Height="800" Width="1280" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#9B87FF" Offset="0" /><GradientStop Color="#6552DF" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="ToolbarTextButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Padding" Value="12,7" /><Setter Property="Margin" Value="3,0" />
        </Style>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="11,9" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="11,10" /><Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="218" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="DetailsColumn" Width="294" /></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="29" /></Grid.RowDefinitions>

        <!-- Left navigation -->
        <Border Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
            <Grid x:Name="ExpandedSidebar">
                <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,20,12,18" VerticalAlignment="Top">
                    <Image Source="/Assets/icon.png" Width="34" Height="34" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="z_compression" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="ARCHIVE STUDIO" FontSize="8" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Tag="Selected" Click="OnHome">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🏠" FontFamily="Segoe UI Emoji" FontSize="16" Width="28" /><TextBlock Text="{local:Loc Home}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnNewArchive">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="{local:Loc NewArchive}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnExtract">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🗜️" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="{local:Loc Extract}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnExtractMany">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🗜️" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="{local:Loc ExtractMany}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnOpen">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="📂" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="{local:Loc OpenArchive}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Separator Margin="20,14" Background="{DynamicResource BorderBrush}" />
                    <Button Style="{StaticResource NavButton}" IsEnabled="False">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="🕘" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="{local:Loc Recent}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button Style="{StaticResource NavButton}" Click="OnSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="15" Width="28" /><TextBlock Text="{local:Loc Settings}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="OnSidebarToggle">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◀" FontSize="15" Width="28" /><TextBlock Text="{local:Loc CollapseSidebar}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid x:Name="CollapsedSidebar" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="82" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Image Source="/Assets/icon.png" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" />
                <StackPanel Grid.Row="1">
                    <Button Style="{StaticResource NavButton}" Tag="Selected" Margin="8,2" Padding="10" Click="OnHome" ToolTip="{local:Loc Home}"><TextBlock Text="🏠" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnNewArchive" ToolTip="{local:Loc NewArchive}"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnExtract" ToolTip="{local:Loc Extract}"><TextBlock Text="🗜️" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnOpen" ToolTip="{local:Loc OpenArchive}"><TextBlock Text="📂" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" IsEnabled="False" ToolTip="{local:Loc Recent}"><TextBlock Text="🕘" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnSettings" ToolTip="{local:Loc Settings}"><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" FontSize="16" /></Button>
                    <Button Style="{StaticResource NavButton}" Margin="8,2" Padding="10" Click="OnSidebarToggle" ToolTip="{local:Loc ExpandSidebar}"><TextBlock Text="▶" FontSize="14" /></Button>
                </StackPanel>
            </Grid>
            </Grid>
        </Border>

        <!-- Top command bar -->
        <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid x:Name="CommandBar" Margin="14,0" MinHeight="58" SizeChanged="OnCommandBarSizeChanged">
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="SearchColumn" Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="⬅️" ToolTip="{local:Loc ParentFolder}" IsEnabled="{Binding CanNavigateUp}" Click="OnNavigateUp" />
                    <Button Style="{StaticResource IconButton}" Content="⬆️" ToolTip="{local:Loc ParentFolder}" IsEnabled="{Binding CanNavigateUp}" Click="OnNavigateUp" />
                    <Border Margin="8,0" Width="1" Height="24" Background="{DynamicResource BorderBrush}" />
                </StackPanel>
                <Button Grid.Column="1" MaxWidth="220" HorizontalAlignment="Stretch" VerticalAlignment="Center" Style="{StaticResource ToolbarTextButton}" Click="OnOpen" ToolTip="{Binding BreadcrumbText}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="📂" FontFamily="Segoe UI Emoji" Margin="0,0,7,0" />
                        <TextBlock Grid.Column="1" Text="{Binding BreadcrumbText}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
                <TextBox x:Name="ArchiveSearchBox" Grid.Column="2" MaxWidth="250" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{local:Loc SearchArchive}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarTextButton}" Content="{local:Loc NewArchive}" Click="OnNewArchive" />
                    <Button Style="{StaticResource ToolbarTextButton}" Content="{local:Loc Extract}" Click="OnExtract" />
                    <Button Style="{StaticResource ToolbarTextButton}" Content="{local:Loc Test}" Click="OnTest" />
                    <Button Style="{StaticResource IconButton}" Content="ⓘ" ToolTip="{local:Loc Details}" Click="OnToggleDetails" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Home workspace -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource WorkspaceBackgroundBrush}" Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel Width="540" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-30,0,0">
                <Image Source="/Assets/icon.png" Width="68" Height="68" HorizontalAlignment="Center" />
                <TextBlock Text="{local:Loc HeroTitle}" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,24,0,0" />
                <TextBlock Text="{local:Loc HeroSubtitle}" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,25,0,0">
                    <Button Style="{StaticResource AccentButton}" Click="OnNewArchive" Margin="4"><StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,7,0"/><TextBlock Text="{local:Loc CreateArchive}"/></StackPanel></Button>
                    <Button Style="{StaticResource OutlineButton}" Click="OnOpen" Margin="4"><StackPanel Orientation="Horizontal"><TextBlock Text="📂" FontFamily="Segoe UI Emoji" FontSize="16" Margin="0,0,7,0"/><TextBlock Text="{local:Loc OpenArchive}"/></StackPanel></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,15">
                    <TextBlock Text="{local:Loc Streaming}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" />
                    <TextBlock Text="{local:Loc SafePaths}" FontFamily="Segoe UI Emoji, Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" />
                    <TextBlock Text="{local:Loc UnicodeNames}" FontFamily="Segoe UI Emoji, Segoe UI" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" />
                </StackPanel>
                <Grid Height="64" Margin="18,0">
                    <Rectangle RadiusX="9" RadiusY="9" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1" StrokeDashArray="4 4" />
                    <TextBlock Text="{local:Loc Drop}" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Archive explorer workspace -->
        <Grid Grid.Column="1" Grid.Row="1" Background="{DynamicResource WorkspaceBackgroundBrush}" Visibility="{Binding HasArchive, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="52" /><RowDefinition Height="*" /><RowDefinition Height="27" /></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Margin="13,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" Click="OnExtract"><StackPanel Orientation="Horizontal"><TextBlock Text="🗜️" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="{local:Loc Extract}"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" Click="OnAddFiles" IsEnabled="{Binding CanModifyCurrentArchive}"><StackPanel Orientation="Horizontal"><TextBlock Text="➕" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="{local:Loc AddFiles}"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" IsEnabled="False"><StackPanel Orientation="Horizontal"><TextBlock Text="🗑️" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="{local:Loc DeleteFiles}"/></StackPanel></Button>
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" Click="OnTest"><StackPanel Orientation="Horizontal"><TextBlock Text="🧪" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="{local:Loc Test}"/></StackPanel></Button>
                    <Separator Width="1" Margin="8,8" Background="{DynamicResource BorderBrush}" />
                    <Button Style="{StaticResource NavButton}" Padding="8,5" Margin="2,0" Click="OnSettings"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" Margin="0,0,6,0"/><TextBlock Text="{local:Loc Settings}"/></StackPanel></Button>
                </StackPanel>
            </Border>
            <Grid Grid.Row="1" Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding BreadcrumbText}" FontSize="15" FontWeight="SemiBold" Cursor="Hand" ToolTip="{local:Loc ArchiveTitleDragHint}"
                               PreviewMouseLeftButtonDown="OnArchiveTitleDragStart" PreviewMouseMove="OnArchiveTitleDragMove" />
                    <TextBlock Text="{local:Loc FolderDoubleClickHint}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding BrowserItemCountText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
            </Grid>
            <DataGrid x:Name="ArchiveGrid" Grid.Row="2" Margin="0" ItemsSource="{Binding BrowserItems}" SelectedItem="{Binding SelectedBrowserItem, Mode=TwoWay}" MouseDoubleClick="OnArchiveItemDoubleClick"
                      SelectionMode="Extended" SelectionUnit="FullRow" PreviewMouseLeftButtonDown="OnArchiveDragStart" PreviewMouseMove="OnArchiveDragMove"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" HeadersVisibility="Column"
                      Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1"
                      GridLinesVisibility="All" HorizontalGridLinesBrush="{DynamicResource BorderBrush}" VerticalGridLinesBrush="{DynamicResource BorderBrush}"
                      RowBackground="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource ControlBackgroundBrush}"
                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True"
                      CellStyle="{StaticResource GridCell}" ColumnHeaderStyle="{StaticResource GridHeader}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="{local:Loc Name}" Width="2.6*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" FontSize="15" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{local:Loc CompressedSize}" Binding="{Binding CompressedSize, StringFormat={}{0:N0} B}" Width="1.1*" />
                    <DataGridTextColumn Header="{local:Loc OriginalSize}" Binding="{Binding OriginalSize, StringFormat={}{0:N0} B}" Width="1.1*" />
                    <DataGridTextColumn Header="{local:Loc FileType}" Binding="{Binding TypeText}" Width="1.3*" />
                    <DataGridTextColumn Header="{local:Loc ModifiedDate}" Binding="{Binding Modified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}">
                <TextBlock Text="{Binding BrowserStatus}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="12,0" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- Details pane -->
        <Border x:Name="DetailsPane" Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><TranslateTransform X="0" /></Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="ⓘ" FontSize="15" Margin="0,0,9,0" /><TextBlock Text="{local:Loc Details}" FontWeight="SemiBold" /></StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Content="×" Click="OnCloseDetails" BorderThickness="0" Background="Transparent" />
                </Grid>
                <Border Grid.Row="0" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource BorderBrush}" />

                <StackPanel Grid.Row="1" Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28">
                    <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="36" Foreground="{DynamicResource DisabledTextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{local:Loc SelectItem}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,0" />
                    <TextBlock Text="{local:Loc SelectItemHint}" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibility}}" Margin="22,28">
                    <Border Width="54" Height="54" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                        <TextBlock Text="📄" FontFamily="Segoe UI Emoji" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding SelectedEntry.Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,2" />
                    <TextBlock Text="{Binding SelectedEntry.Path}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" FontSize="11" />
                    <Separator Margin="0,22" Background="{DynamicResource BorderBrush}" />
                    <TextBlock Text="{local:Loc OriginalSize}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.OriginalSize, StringFormat={}{0:N0} bytes}" Margin="0,4,0,15" />
                    <TextBlock Text="{local:Loc CompressedSize}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.CompressedSize, StringFormat={}{0:N0} bytes}" Margin="0,4,0,15" />
                    <TextBlock Text="{local:Loc ModifiedDate}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.Modified, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Margin="0,4,0,15" />
                    <TextBlock Text="CRC / Checksum" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" /><TextBlock Text="{Binding SelectedEntry.Checksum}" FontFamily="Consolas" Margin="0,4,0,15" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="13,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0"/><TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" /></StackPanel>
                <ProgressBar Grid.Column="1" Height="3" Margin="18,0" Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressDetails}" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,10,0" />
                    <Button Style="{StaticResource NavButton}" Padding="5,1" Margin="0" Content="{local:Loc Cancel}" Click="OnCancel" IsEnabled="{Binding IsBusy}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
