<Window x:Class="ZCompression.App.NewArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 압축 만들기" Width="760" Height="610" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="새 압축 만들기" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="압축할 파일과 폴더를 추가하고 저장 옵션을 선택하세요." Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}" Margin="4,0" Click="OnAddFiles"><StackPanel Orientation="Horizontal"><TextBlock Text="📄" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/><TextBlock Text="파일 추가"/></StackPanel></Button>
                <Button Style="{StaticResource AccentButton}" Margin="4,0" Click="OnAddFolder"><StackPanel Orientation="Horizontal"><TextBlock Text="📁" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/><TextBlock Text="폴더 추가"/></StackPanel></Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListView x:Name="SourceList" ItemsSource="{Binding Sources}" Background="Transparent" BorderThickness="0" SelectionMode="Extended">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="이름" Width="210"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="종류" DisplayMemberBinding="{Binding TypeText}" Width="70"/>
                            <GridViewColumn Header="크기" DisplayMemberBinding="{Binding SizeText}" Width="90"/>
                            <GridViewColumn Header="위치" DisplayMemberBinding="{Binding FullPath}" Width="310"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,7" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Sources.Count, StringFormat={}{0}개 항목}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource NavButton}" Padding="8,4" Margin="0" Content="선택 제거" Click="OnRemoveSelected"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="저장 위치" FontWeight="SemiBold" FontSize="11"/>
                    <Grid Margin="0,7,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LocationBox" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="찾아보기" Margin="8,0,0,0" Click="OnBrowseDestination"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,12,0">
                    <TextBlock Text="압축 파일 이름" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox x:Name="FileNameBox" Margin="0,7,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="압축 형식" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="FormatBox" Margin="0,7,0,0" SelectionChanged="OnFormatChanged">
                        <ComboBoxItem Tag="Zip" IsSelected="True">ZIP</ComboBoxItem><ComboBoxItem Tag="SevenZip">7Z</ComboBoxItem>
                        <ComboBoxItem Tag="Tar">TAR</ComboBoxItem><ComboBoxItem Tag="TarGZip">TAR.GZ</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="압축 수준" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="LevelBox" Margin="0,7,0,0" SelectedIndex="3">
                        <ComboBoxItem Tag="Store">저장만</ComboBoxItem><ComboBoxItem Tag="Fastest">매우 빠름</ComboBoxItem>
                        <ComboBoxItem Tag="Fast">빠름</ComboBoxItem><ComboBoxItem Tag="Normal">보통</ComboBoxItem>
                        <ComboBoxItem Tag="High">높음</ComboBoxItem><ComboBoxItem Tag="Ultra">최고</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#E35D6A" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource OutlineButton}" Content="취소" Width="92" Margin="4,0" IsCancel="True"/>
                <Button Style="{StaticResource AccentButton}" Width="128" Margin="4,0" Click="OnStartCompression" IsDefault="True">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/><TextBlock Text="압축 시작"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
