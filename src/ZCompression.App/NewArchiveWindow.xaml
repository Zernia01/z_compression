<Window x:Class="ZCompression.App.NewArchiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZCompression.App"
        Title="{local:Loc NewArchiveTitle}" Width="760" Height="610" MinWidth="680" MinHeight="540"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
    <Grid Margin="24,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{local:Loc NewArchiveTitle}" FontSize="23" FontWeight="SemiBold"/>
                <TextBlock Text="{local:Loc NewArchiveDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource OutlineButton}" Margin="4,0" Click="OnAddFiles"><StackPanel Orientation="Horizontal"><TextBlock Text="📄" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/><TextBlock Text="{local:Loc AddFiles}"/></StackPanel></Button>
                <Button Style="{StaticResource AccentButton}" Margin="4,0" Click="OnAddFolder"><StackPanel Orientation="Horizontal"><TextBlock Text="📁" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/><TextBlock Text="{local:Loc AddFolder}"/></StackPanel></Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,18,0,16" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListView x:Name="SourceList" ItemsSource="{Binding Sources}" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" BorderThickness="0" SelectionMode="Extended">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="3,2"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{local:Loc Name}" Width="210"><GridViewColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Icon}" FontFamily="Segoe UI Emoji" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}"/></StackPanel></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{local:Loc Type}" Width="70"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding TypeText}" Foreground="{DynamicResource PrimaryTextBrush}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{local:Loc Size}" Width="90"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding SizeText}" Foreground="{DynamicResource PrimaryTextBrush}"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                            <GridViewColumn Header="{local:Loc Location}" Width="310"><GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FullPath}" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,7" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SourceCountText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource NavButton}" Padding="8,4" Margin="0" Content="{local:Loc RemoveSelected}" Click="OnRemoveSelected"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="145"/><ColumnDefinition Width="145"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="{local:Loc SaveLocation}" FontWeight="SemiBold" FontSize="11"/>
                    <Grid Margin="0,7,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LocationBox" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="{local:Loc Browse}" Margin="8,0,0,0" Click="OnBrowseDestination"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,12,0">
                    <TextBlock Text="{local:Loc ArchiveName}" FontWeight="SemiBold" FontSize="11"/>
                    <TextBox x:Name="FileNameBox" Margin="0,7,0,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{local:Loc ArchiveFormat}" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="FormatBox" Margin="0,7,0,0" SelectionChanged="OnFormatChanged">
                        <ComboBoxItem Tag="Zip" IsSelected="True">ZIP</ComboBoxItem><ComboBoxItem Tag="SevenZip">7Z</ComboBoxItem>
                        <ComboBoxItem Tag="Tar">TAR</ComboBoxItem><ComboBoxItem Tag="TarGZip">TAR.GZ</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2">
                    <TextBlock Text="{local:Loc CompressionLevel}" FontWeight="SemiBold" FontSize="11"/>
                    <ComboBox x:Name="LevelBox" Margin="0,7,0,0" SelectedIndex="4">
                        <ComboBoxItem Tag="Store" Content="{local:Loc StoreOnly}"/><ComboBoxItem Tag="Fastest" Content="{local:Loc Fastest}"/>
                        <ComboBoxItem Tag="Fast" Content="{local:Loc Fast}"/><ComboBoxItem Tag="Normal" Content="{local:Loc Normal}"/>
                        <ComboBoxItem Tag="High" Content="{local:Loc High}"/><ComboBoxItem Tag="Ultra" Content="{local:Loc Ultra}"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="ValidationText" Foreground="#E35D6A" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource OutlineButton}" Content="{local:Loc Cancel}" Width="92" Margin="4,0" IsCancel="True"/>
                <Button Style="{StaticResource AccentButton}" Width="128" Margin="4,0" Click="OnStartCompression" IsDefault="True">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="📦" FontFamily="Segoe UI Emoji" Margin="0,0,7,0"/><TextBlock Text="{local:Loc StartCompression}"/></StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
