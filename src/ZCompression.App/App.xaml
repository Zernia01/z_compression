<Application x:Class="ZCompression.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ZCompression.App"
             Startup="OnStartup">
    <Application.Resources>
        <local:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:NullToVisibilityConverter x:Key="NullToVisibility" />

        <SolidColorBrush x:Key="AccentBrush" Color="#846CF6" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#927EFF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C294C" />
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#0B0E13" />
        <SolidColorBrush x:Key="WorkspaceBackgroundBrush" Color="#0B0E13" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#10141C" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#11161E" />
        <SolidColorBrush x:Key="ElevatedBackgroundBrush" Color="#171C26" />
        <SolidColorBrush x:Key="ControlBackgroundBrush" Color="#141A24" />
        <SolidColorBrush x:Key="BorderBrush" Color="#27303D" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F4FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#94A0B3" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#596273" />

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="Icon" Value="/Assets/z_compression.ico" />
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Background" Property="Background" Value="{DynamicResource AccentHoverBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Background" Property="Opacity" Value="0.78" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Background" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Background" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Background" Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Background" Property="Opacity" Value="0.75" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Background" Property="Opacity" Value="0.35" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource OutlineButton}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontFamily" Value="Segoe UI Emoji, Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="13,10" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBackground" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Trigger>
                            <Trigger Property="Tag" Value="Selected"><Setter TargetName="NavBackground" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
