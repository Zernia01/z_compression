<Window x:Class="ZCompression.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ZCompression.App"
        Title="{local:Loc SettingsTitle}" Width="820" Height="570" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" MouseLeftButtonDown="OnWindowMouseDown" Loaded="OnLoaded">
    <Window.Resources>
        <Style x:Key="SettingsNav" TargetType="Button" BasedOn="{StaticResource NavButton}">
            <Setter Property="Margin" Value="12,3" /><Setter Property="Padding" Value="13,10" />
        </Style>
        <Style x:Key="ThemeChoice" TargetType="RadioButton">
            <Setter Property="Width" Value="130" /><Setter Property="Height" Value="88" /><Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Box" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9">
                            <Grid><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource ElevatedBackgroundBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="SettingsCard" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform><ScaleTransform ScaleX="0.97" ScaleY="0.97"/></Border.RenderTransform>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="186" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

            <Border Background="{DynamicResource ElevatedBackgroundBrush}" CornerRadius="14,0,0,14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="72" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{local:Loc Settings}" FontSize="20" FontWeight="SemiBold" Margin="22,22,0,0" />
                    <StackPanel Grid.Row="1">
                        <Button x:Name="GeneralNav" Style="{StaticResource SettingsNav}" CommandParameter="general" Click="OnCategoryChanged">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚙️" FontFamily="Segoe UI Emoji" Width="28" FontSize="15"/><TextBlock Text="{local:Loc General}"/></StackPanel>
                        </Button>
                        <Button x:Name="ShortcutsNav" Style="{StaticResource SettingsNav}" CommandParameter="shortcuts" Click="OnCategoryChanged">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⌨️" FontFamily="Segoe UI Emoji" Width="28" FontSize="15"/><TextBlock Text="{local:Loc Shortcuts}"/></StackPanel>
                        </Button>
                        <Button x:Name="AppearanceNav" Style="{StaticResource SettingsNav}" Tag="Selected" CommandParameter="appearance" Click="OnCategoryChanged">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="🎨" FontFamily="Segoe UI Emoji" Width="28" FontSize="15"/><TextBlock Text="{local:Loc Appearance}"/></StackPanel>
                        </Button>
                        <Button x:Name="PerformanceNav" Style="{StaticResource SettingsNav}" CommandParameter="performance" Click="OnCategoryChanged">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="⚡" FontFamily="Segoe UI Emoji" Width="28" FontSize="15"/><TextBlock Text="{local:Loc Performance}"/></StackPanel>
                        </Button>
                        <Button x:Name="AboutNav" Style="{StaticResource SettingsNav}" CommandParameter="about" Click="OnCategoryChanged">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="ℹ️" FontFamily="Segoe UI Emoji" Width="28" FontSize="15"/><TextBlock Text="{local:Loc About}"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Button Grid.Row="0" Content="×" Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,13,14,0" Background="Transparent" BorderThickness="0" FontSize="18" Click="OnDone" />

                <Grid Grid.Row="1" Margin="38,8,38,34">
                    <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                        <TextBlock Text="{local:Loc General}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Loc GeneralDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,26" />
                        <Separator Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{local:Loc Language}" FontWeight="SemiBold" Margin="0,22,0,8" />
                        <ComboBox x:Name="LanguageBox" Width="280" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Tag="auto">시스템 기본값</ComboBoxItem><ComboBoxItem Tag="ko-KR">한국어</ComboBoxItem>
                            <ComboBoxItem Tag="en-US">English</ComboBoxItem><ComboBoxItem Tag="ja-JP">日本語</ComboBoxItem>
                            <ComboBoxItem Tag="zh-CN">简体中文</ComboBoxItem><ComboBoxItem Tag="zh-TW">繁體中文</ComboBoxItem><ComboBoxItem Tag="ko-Hanja">國漢文混用文</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="{local:Loc DefaultFormat}" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <ComboBox Width="280" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem>ZIP</ComboBoxItem><ComboBoxItem>7Z</ComboBoxItem><ComboBoxItem>TAR.GZ</ComboBoxItem></ComboBox>
                        <Grid Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{local:Loc WindowsDefaultApps}" FontWeight="SemiBold"/><TextBlock Text="{local:Loc WindowsDefaultAppsDescription}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,12,0"/></StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource OutlineButton}" Content="{local:Loc SetDefaultApp}" Click="OnSetDefaultApps" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{local:Loc AutomaticUpdates}" FontWeight="SemiBold"/><TextBlock Text="{local:Loc AutomaticUpdatesDescription}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,12,0"/></StackPanel>
                            <CheckBox x:Name="AutomaticUpdatesBox" Grid.Column="1" VerticalAlignment="Center" Checked="OnAutomaticUpdatesChanged" Unchecked="OnAutomaticUpdatesChanged" />
                        </Grid>
                        <Button Style="{StaticResource OutlineButton}" Content="{local:Loc CheckForUpdatesNow}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnCheckForUpdates" />
                        <CheckBox Content="{local:Loc NotifyWhenComplete}" Margin="0,20,0,0" IsChecked="True" />
                    </StackPanel>

                    <StackPanel x:Name="ShortcutsPanel" Visibility="Collapsed">
                        <TextBlock Text="{local:Loc Shortcuts}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Loc ShortcutsDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,26" />
                        <Separator Background="{DynamicResource BorderBrush}" />
                        <Grid Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{local:Loc CompressShortcut}" FontWeight="SemiBold"/><TextBlock Text="{local:Loc CompressAction}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,12,0"/></StackPanel>
                            <Button x:Name="CompressShortcutButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Click="OnShortcutCaptureClick" PreviewKeyDown="OnShortcutKeyDown" LostKeyboardFocus="OnShortcutCaptureLostFocus" Tag="compress" />
                        </Grid>
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="{local:Loc ExtractShortcut}" FontWeight="SemiBold"/><TextBlock Text="{local:Loc ExtractAction}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,12,0"/></StackPanel>
                            <Button x:Name="ExtractShortcutButton" Grid.Column="1" Style="{StaticResource OutlineButton}" Click="OnShortcutCaptureClick" PreviewKeyDown="OnShortcutKeyDown" LostKeyboardFocus="OnShortcutCaptureLostFocus" Tag="extract" />
                        </Grid>
                        <TextBlock Text="{local:Loc ShortcutCaptureHint}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,24,0,0" />
                        <TextBlock x:Name="ShortcutValidationText" Foreground="#E35D6A" TextWrapping="Wrap" Margin="0,12,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="AppearancePanel">
                        <TextBlock Text="{local:Loc Appearance}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Loc AppearanceDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,26" />
                        <Separator Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{local:Loc AppTheme}" FontWeight="SemiBold" Margin="0,22,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SystemTheme" GroupName="Theme" Tag="system" Style="{StaticResource ThemeChoice}" Checked="OnThemeChanged">
                                <StackPanel><TextBlock Text="🖥️" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="{local:Loc SystemTheme}" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LightTheme" GroupName="Theme" Tag="light" Style="{StaticResource ThemeChoice}" Checked="OnThemeChanged">
                                <StackPanel><TextBlock Text="☀️" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="{local:Loc LightTheme}" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DarkTheme" GroupName="Theme" Tag="dark" Style="{StaticResource ThemeChoice}" Checked="OnThemeChanged">
                                <StackPanel><TextBlock Text="🌙" FontFamily="Segoe UI Emoji" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="{local:Loc DarkTheme}" Margin="0,10,0,0" HorizontalAlignment="Center"/></StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,20" />
                        <TextBlock Text="{local:Loc Interface}" FontWeight="SemiBold" />
                        <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{local:Loc ReduceAnimations}"/><TextBlock Text="{local:Loc ReduceAnimationsDescription}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0"/></StackPanel>
                            <CheckBox Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="PerformancePanel" Visibility="Collapsed">
                        <TextBlock Text="{local:Loc Performance}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Loc PerformanceDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,26" />
                        <Separator Background="{DynamicResource BorderBrush}" />
                        <TextBlock Text="{local:Loc CpuThreads}" FontWeight="SemiBold" Margin="0,22,0,8" />
                        <ComboBox x:Name="CpuThreadsBox" Width="280" HorizontalAlignment="Left" SelectionChanged="OnCpuThreadsChanged"><ComboBoxItem Tag="0" Content="{local:Loc Automatic}"/><ComboBoxItem Tag="2">2</ComboBoxItem><ComboBoxItem Tag="4">4</ComboBoxItem><ComboBoxItem Tag="8">8</ComboBoxItem></ComboBox>
                        <TextBlock Text="{local:Loc Priority}" FontWeight="SemiBold" Margin="0,24,0,8" />
                        <ComboBox x:Name="PriorityBox" Width="280" HorizontalAlignment="Left" SelectionChanged="OnPriorityChanged"><ComboBoxItem Tag="low" Content="{local:Loc Low}"/><ComboBoxItem Tag="normal" Content="{local:Loc Normal}"/><ComboBoxItem Tag="high" Content="{local:Loc High}"/></ComboBox>
                        <TextBlock Text="{local:Loc StabilityHint}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,22,0,0" />
                    </StackPanel>

                    <StackPanel x:Name="AboutPanel" Visibility="Collapsed">
                        <TextBlock Text="{local:Loc About}" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="{local:Loc AboutDescription}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,26" />
                        <Separator Background="{DynamicResource BorderBrush}" />
                        <Image Source="/Assets/icon.png" Width="58" Height="58" HorizontalAlignment="Left" Margin="0,24,0,12"/>
                        <TextBlock Text="z_compression" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="Version 1.0.7 · MIT License" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" />
                        <TextBlock Text="{local:Loc PrivacyStatement}" Margin="0,24,0,0" />
                        <Button Style="{StaticResource AccentButton}" Content="☕  Buy Me a Coffee" HorizontalAlignment="Left" Margin="0,22,0,0" Click="OnDonate" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
